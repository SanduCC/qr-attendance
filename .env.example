# Copy to .env and fill in. .env is gitignored - never commit real secrets.
# Generate secrets with:  openssl rand -base64 48

# HTTP port (Cloud Run sets this automatically)
PORT=8080

# PostgreSQL (JDBC URL). Defaults match docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5432/attendance
DATABASE_USERNAME=attendance
DATABASE_PASSWORD=attendance

# Redis. Use rediss:// for TLS (e.g. Upstash): rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# Base URL encoded in the QR code. Must be reachable from students' phones
# (for a real phone use your tunnel/production https URL).
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated allowlist of teacher Google account emails
TEACHER_EMAILS=teacher@example.com

# Google OAuth web client (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: {PUBLIC_BASE_URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Rotating-QR HMAC key, at least 32 characters
QR_HMAC_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Pepper for IP/device hashes and the device-cookie signature, at least 32 characters
HASH_PEPPER=change-me-to-another-random-string-of-at-least-32-chars

# Secure flag on cookies. Keep true; set false only for plain-http local dev
# in browsers other than Chrome (Chrome treats http://localhost as secure).
COOKIE_SECURE=true

# Set to "framework" when running behind a TLS-terminating proxy (Cloud Run, Caddy, nginx)
FORWARD_HEADERS_STRATEGY=none

# Spring profile. ./mvnw spring-boot:run uses "local" automatically.
# SPRING_PROFILES_ACTIVE=
